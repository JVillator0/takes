APP_NAME=Takes
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://takes.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=takes
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reverb (spec 5, D-028). BROADCAST_CONNECTION=reverb turns live updates on;
# with `log` the client simply polls. REVERB_SERVER_PORT is what
# `reverb:start` binds, REVERB_PORT what browsers connect to: pool worktrees
# use their slot (8080 to 8085, .claude/worktree-pool.md).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_PORT=8080
# REVERB_SERVER=
# REVERB_SERVER_HOST=
# REVERB_SERVER_PATH=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Takes product settings (config/takes.php, spec 3-01). USD values are decimal strings.
TAKES_SUPPORT_EMAIL=support@example.com
TAKES_DAILY_CAP_PER_CUSTOMER=40
TAKES_DAILY_CAP_GLOBAL=300
WELCOME_CREDIT_USD=1.00
AI_SUGGESTIONS_ENABLED=true
AI_DAILY_BUDGET_USD=1.00
AI_DAILY_LIMIT_PER_CUSTOMER=30
TAKES_AI_THROTTLE_PER_MINUTE=6
# Describe a change (spec 8, laravel/ai Anthropic provider). Its own workspace key with a monthly limit (D-046); never commit it.
ANTHROPIC_API_KEY=
DEMO_LOGIN_ENABLED=false
DEMO_LOGIN_THROTTLE_PER_IP=5
DEMO_ACCOUNTS_PASSWORD=password

# Pixelforge (spec 3-04). Use one API key per environment; never commit a key.
PIXELFORGE_BASE_URL=https://pixelforge.promptedit.dev/v1
PIXELFORGE_API_KEY=
PIXELFORGE_WEBHOOK_SECRET=
PIXELFORGE_WEBHOOK_TOLERANCE=300
# PIXELFORGE_IMAGE_HOST=  (defaults to the API host)

# --------------------------------------------------------------------
# Optional framework settings read in config/. Unset means the default in
# the named config file applies; uncomment a line to override it.
# (Kept so tests/Arch/RepositoryTest.php can assert full env coverage.)

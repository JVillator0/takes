# 1Password secret references for scripts/env-from-1password.sh.
#
# Copy to scripts/secrets.local.env (git-ignored) and replace the placeholders.
# References are not secrets, but they name private vaults and items, so the
# filled-in copy never goes into git. Leave a line as a placeholder (or delete
# it) to skip that key. Names: <ENV>_<KEY>_REF with ENV = LOCAL | PRODUCTION.
#
# Without 1Password, set TAKES_KEYSTORE_DIR to a private directory holding
# local.env / prod.env (plain KEY=value files) and this file is not read.

LOCAL_PIXELFORGE_API_KEY_REF="op://<vault>/<item>/credential"
LOCAL_PIXELFORGE_WEBHOOK_SECRET_REF="op://<vault>/<item>/<field>"
LOCAL_ANTHROPIC_API_KEY_REF="op://<vault>/<item>/credential"

PRODUCTION_PIXELFORGE_API_KEY_REF="op://<vault>/<item>/credential"
PRODUCTION_PIXELFORGE_WEBHOOK_SECRET_REF="op://<vault>/<item>/<field>"
PRODUCTION_ANTHROPIC_API_KEY_REF="op://<vault>/<item>/credential"
